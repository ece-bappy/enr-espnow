  "repository": { "type": "git", "url": "https://github.com/ece-bappy/enr-espnow.git" },
  "license": "MIT",
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "headers": ["ENR_ESPNOW.h", "enr.h"],
  "examples": [
    { "name": "Controller", "base": "examples/Controller", "files": ["Controller.ino"] },
    { "name": "Node", "base": "examples/Node", "files": ["Node.ino"] },
    { "name": "KeyTool", "base": "examples/KeyTool", "files": ["KeyTool.ino"] }
  ]
}
